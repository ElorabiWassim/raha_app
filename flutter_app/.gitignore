# Flutter-specific ignores (not covered by root .gitignore)
/ios/Pods/
/android/app/build/
/android/app/debug/
/android/app/profile/
/android/app/release/
/web/
/lib/generated/
/assets/fonts/  # if you have custom fonts

# Flutter coverage
coverage/

# Flutter drive files
.drive/

# Flutter test outputs
.flutter-test/

# Local configuration
.flutter/